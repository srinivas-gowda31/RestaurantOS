PORT=5000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=restaurantos

JWT_SECRET=replace-this-with-a-long-random-string

# Required for AI features (predictions, pricing, waste analysis, invoice OCR, etc.)
# Gemini Flash - free tier at ai.google.dev. Invoice OCR falls back to local Tesseract OCR if not set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Required for invoice file storage (cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
