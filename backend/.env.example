PORT=5000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=restaurantos

JWT_SECRET=replace-this-with-a-long-random-string

# Required for AI features (predictions, pricing, waste analysis, etc.)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Required for invoice OCR/extraction (Gemini Flash - free tier at ai.google.dev)
# Falls back to local Tesseract OCR if not set
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
